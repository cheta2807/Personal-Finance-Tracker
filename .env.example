# Copy to .env and generate a different random value for each secret.
DJANGO_SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# True is for local HTTP development only. Use false with HTTPS in production.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
DJANGO_TRUST_PROXY=false
